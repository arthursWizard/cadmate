{
  "name": "cadmate",
  "version": "0.1.0",
  "description": "KiCad and FreeCAD companion: footprints, symbols, 3D models, routing, reviews and enclosure checks, with the skills that go with them.",
  "author": { "name": "arthursWizard" },
  "homepage": "https://github.com/arthursWizard/cadmate",
  "repository": "https://github.com/arthursWizard/cadmate",
  "license": "MIT",
  "keywords": ["kicad", "freecad", "pcb", "eda", "cad"],
  "mcpServers": {
    "cadmate": {
      "command": "uv",
      "args": ["run", "--quiet", "--frozen", "--no-dev", "--directory", "${CLAUDE_PLUGIN_ROOT}", "cadmate"]
    }
  }
}
